{
  "name": "finapp",
  "version": "1.0.0",
  "private": true,
  "description": "Estimate your financial future in the browser: cumulative income, expenses, net and net worth over the months ahead, with several plans side by side.",
  "homepage": "https://finapp.siniverse.cc/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinikebe/finapp.git"
  },
  "bugs": {
    "url": "https://github.com/sinikebe/finapp/issues"
  },
  "keywords": [
    "pwa",
    "progressive-web-app",
    "offline-first",
    "service-worker",
    "vanilla-javascript",
    "no-dependencies",
    "no-build-step",
    "personal-finance",
    "financial-planning",
    "data-visualization",
    "sankey-diagram",
    "es-modules",
    "i18n",
    "github-pages",
    "claude-code"
  ],
  "type": "module",
  "scripts": {
    "ci:check": "npm test && npm run icons && git diff --exit-code -- assets/icons && node tools/check-cache-version.mjs",
    "ci:build": "node tools/build-cloudflare-worker.mjs",
    "ci:pages": "node tools/ci-pages.mjs",
    "dev": "node tools/serve.mjs",
    "start": "node tools/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "icons": "node tools/generate-icons.mjs",
    "stamp": "node tools/stamp-version.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1",
  "devDependencies": {
    "wrangler": "4.161.0"
  },
  "license": "MIT"
}
