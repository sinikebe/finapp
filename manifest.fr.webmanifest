{
  "name": "Finapp — estimez votre avenir financier",
  "short_name": "Finapp",
  "description": "Projetez vos revenus, vos dépenses et votre solde net cumulés sur les mois à venir. Fonctionne hors ligne ; rien ne quitte votre appareil.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#f9f9f7",
  "theme_color": "#f9f9f7",
  "lang": "fr",
